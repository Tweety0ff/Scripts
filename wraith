        tabUtility:Section({Title = "Server Hop"}):Button(
            {
                Title = "Server Hop",
                Callback = function()
                    local request_ = syn and syn.request or http_request or request or http and http.request
                    local data

                    if type(request_) == "function" then
                        local httpResult = request_(
                            {
                                Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=100",
                                Method = "GET",
                            }
                        )

                        local body

                        if httpResult then
                            body = httpResult.Body or httpResult.body
                        else
                            body = httpResult
                        end

                        data = nil

                        if body then
                            data = HttpService:JSONDecode(httpResult.Body or httpResult.body)
                        end
                    else
                        local ok, result = pcall(
                            function()
                                return game:HttpGet(
                                    "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=100"
                                )
                            end
                        )

                        ok = ok and result
                        data = nil

                        if ok then
                            data = HttpService:JSONDecode(result)
                        end
                    end

                    if data and data.data and #data.data > 0 then
                        TeleportService:TeleportToPlaceInstance(
                            game.PlaceId, data.data[math.random(#data.data)].id, localPlayer
                        )
                    end
                end,
            }
