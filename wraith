                            end
                        end
                    )

                    pcall(
                        function()
                            if entry.Glow then
                                entry.Glow:Destroy()
                            end
                        end
                    )

                    pcall(
                        function()
                            if entry.Proxy then
                                entry.Proxy:Destroy()
                            end
                        end
