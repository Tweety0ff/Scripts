            local function drawLine(line, fromPos, toPos, thick)
                local dx = toPos.X - fromPos.X
                local dy = toPos.Y - fromPos.Y
                line.Size = UDim2.fromOffset(
                    math.sqrt(dx * dx + dy * dy), math.max(1, thick or thickness)
                )
                line.Position = UDim2.fromOffset(
                    (fromPos.X + toPos.X) / 2, (fromPos.Y + toPos.Y) / 2
                )
                line.Rotation = math.deg(math.atan2(dy, dx))
                line.BackgroundColor3 = color
                line.Visible = true
            end

            local function worldToScreen(camera, worldPos)
                local screenPos, onScreen = camera:WorldToViewportPoint(worldPos)
                if onScreen and screenPos.Z > 0 then
                    return Vector2.new(screenPos.X, screenPos.Y), screenPos.Z
                end
