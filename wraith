                    emitter.Size = numberSequence(config)
                    local numberSequence2 = NumberSequence.new
                    local tempTable = {}
                    local tp0 = NumberSequenceKeypoint.new(0, 1)
                    local tp1 = NumberSequenceKeypoint.new(0.16, 0.08)
