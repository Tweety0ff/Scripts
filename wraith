task.spawn(
    function()
        local Players
        Players = game:GetService("Players")
        local RunService
        RunService = game:GetService("RunService")
        local TweenService
        TweenService = game:GetService("TweenService")
        local UserInputService
        UserInputService = game:GetService("UserInputService")
        local Lighting
        Lighting = game:GetService("Lighting")
        local Workspace
        Workspace = game:GetService("Workspace")
        local TeleportService
        TeleportService = game:GetService("TeleportService")
        local VirtualInputManager
        VirtualInputManager = game:GetService("VirtualInputManager")
        local TextService
        TextService = game:GetService("TextService")
        game:GetService("Stats")
        local HttpService
        HttpService = game:GetService("HttpService")
        local SoundService
        SoundService = game:GetService("SoundService")
        local localPlayer
        localPlayer = Players.LocalPlayer

        local playerGui
        playerGui = localPlayer:WaitForChild("PlayerGui")
        local currentCamera
        currentCamera = Workspace.CurrentCamera

        Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(
            function()
                currentCamera = Workspace.CurrentCamera
            end
        )

        local mouse
        mouse = localPlayer:GetMouse()

        for _, guiName in ipairs(
            {
                "LogoUI", "WraithWatermark", "WraithTargetHUD", "WraithMinimalNotify",
                "WraithScreenArrows", "WraithMusicPlayer", "WraithBoxSkeletonESP",
                "WraithHugeSnowZone", "DynamicIsland", "WraithLocalSelfChams", "WraithWindUIError",
                "WraithWalkDirection",
            }
        ) do
            pcall(
                function()
                    local existing = playerGui:FindFirstChild(guiName)

                    if existing then
                        existing:Destroy()
                    end
                end
            )
        end

        pcall(
            function()
                local wraithWalkDirection = Workspace:FindFirstChild("WraithWalkDirection")

                if wraithWalkDirection then
                    wraithWalkDirection:Destroy()
                end
            end
        )

        local logoConfig = {
            assetId = "rbxassetid://129691721280832", logoSize = 320, breatheAmp = 0.05,
            breatheFreq = 0.3, gradHeight = 380, pulseFreq = 0.4, lineDist = 160, lineThickness = 2,
            maxLines = 80, repelForce = 260, bounceCooldown = 0.35,
        }

        local particleColors = {
            Color3.fromRGB(168, 85, 247), Color3.fromRGB(147, 51, 234),
            Color3.fromRGB(126, 34, 206), Color3.fromRGB(192, 132, 252),
        }

        local ringColors = {
            Color3.fromRGB(168, 85, 247), Color3.fromRGB(147, 51, 234),
            Color3.fromRGB(126, 34, 206),
        }

        local screenGui
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "LogoUI"
        screenGui.ResetOnSpawn = false
        screenGui.IgnoreGuiInset = true
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screenGui.Parent = playerGui
        local blurEffect
        blurEffect = Instance.new("BlurEffect")
        blurEffect.Size = 20
        blurEffect.Parent = Lighting
        local overlayFrame = Instance.new("Frame", screenGui)
        overlayFrame.Size = UDim2.new(1, 0, 1, 0)
        overlayFrame.BackgroundColor3 = Color3.fromRGB(8, 4, 24)
        overlayFrame.BackgroundTransparency = 0.4
        overlayFrame.ZIndex = 1
        local lerpColor

        lerpColor = function(fromColor, toColor, alpha)
            return Color3.new(
                fromColor.R + (toColor.R - fromColor.R) * alpha,
                fromColor.G + (toColor.G - fromColor.G) * alpha,
                fromColor.B + (toColor.B - fromColor.B) * alpha
            )
        end

        local logoFrame = Instance.new("Frame", screenGui)
        logoFrame.AnchorPoint = Vector2.new(0.5, 0.5)
        logoFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        logoFrame.Size = UDim2.new(0, logoConfig.logoSize, 0, logoConfig.logoSize)
        logoFrame.BackgroundTransparency = 1
        logoFrame.ZIndex = 10
        local imageLabel = Instance.new("ImageLabel", logoFrame)
        imageLabel.AnchorPoint = Vector2.new(0.5, 0.5)
        imageLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
        imageLabel.Size = UDim2.new(1, 0, 1, 0)
        imageLabel.Image = logoConfig.assetId
        imageLabel.BackgroundTransparency = 1
        imageLabel.ScaleType = Enum.ScaleType.Fit
        imageLabel.ZIndex = 10
        local ringSizes = {380, 470, 580}
        local rings = {}

        for i = 1, 3 do
            local frame4 = Instance.new("Frame", screenGui)
            frame4.AnchorPoint = Vector2.new(0.5, 0.5)
            frame4.Position = UDim2.new(0.5, 0, 0.5, 0)
            frame4.Size = UDim2.new(0, ringSizes[i], 0, ringSizes[i])
            frame4.BackgroundTransparency = 1
            frame4.ZIndex = 3
            local uiStroke = Instance.new("UIStroke", frame4)
            uiStroke.Thickness = 1.8 - i * 0.3
            uiStroke.Color = ringColors[1]
            uiStroke.Transparency = 0.35 + i * 0.12
            local uiStroke2 = Instance.new("UIStroke", frame4)
            uiStroke2.Thickness = 3.5
            uiStroke2.Color = ringColors[1]
            uiStroke2.Transparency = 0.75
            Instance.new("UICorner", frame4).CornerRadius = UDim.new(1, 0)

            rings[i] = {
                frame = frame4, stroke = uiStroke, glow = uiStroke2, baseSize = ringSizes[i],
                rotDir = i % 2 == 1 and 1 or -1, rotSpeed = 8 + i * 6, colorPhase = i * 0.8,
                currentRadius = ringSizes[i] / 2,
            }
        end

        local isFunction, loadSource, settings, setConfig, getConfig, saveConfig, loadConfig
        local tabESP, tabHUD, tabWorld, tabCamera, tabEffects, tabAudio, tabUtility
        local showIslandNotify

        do
            local function createFrame(zIndex)
                local frame = Instance.new("Frame", screenGui)
                frame.AnchorPoint = Vector2.new(0, 1)
                frame.Position = UDim2.new(0, 0, 1, 0)
                frame.Size = UDim2.new(1, 0, 0, logoConfig.gradHeight)
                frame.BackgroundTransparency = 1
                frame.ZIndex = zIndex
                return frame
            end

            local gradFrame1 = createFrame(2)
            local gradFrame2 = createFrame(3)
            local gradFrame3 = createFrame(4)
            local uiGradient = Instance.new("UIGradient", gradFrame1)
            uiGradient.Rotation = 90
            uiGradient.Color = ColorSequence.new(
                {
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 4, 24)),
                    ColorSequenceKeypoint.new(0.3, Color3.fromRGB(50, 10, 120)),
                    ColorSequenceKeypoint.new(0.7, Color3.fromRGB(109, 40, 217)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(168, 85, 247)),
                }
            )
            uiGradient.Transparency = NumberSequence.new(
                {
                    NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0.5),
                    NumberSequenceKeypoint.new(1, 0),
                }
            )
            local uiGradient2 = Instance.new("UIGradient", gradFrame2)
            uiGradient2.Rotation = 90
            uiGradient2.Color = ColorSequence.new(
                {
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 4, 24)),
                    ColorSequenceKeypoint.new(0.4, Color3.fromRGB(100, 23, 130)),
                    ColorSequenceKeypoint.new(0.8, Color3.fromRGB(147, 51, 234)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(192, 132, 252)),
                }
            )
            uiGradient2.Transparency = NumberSequence.new(
                {
                    NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.7),
                    NumberSequenceKeypoint.new(1, 0.1),
                }
            )
            local uiGradient3 = Instance.new("UIGradient", gradFrame3)
            uiGradient3.Rotation = 0
            uiGradient3.Color = ColorSequence.new(
                {
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(168, 85, 247)),
                    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(192, 132, 252)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(126, 34, 206)),
                }
            )
            uiGradient3.Transparency = NumberSequence.new(
                {
                    NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.38, 0.4),
                    NumberSequenceKeypoint.new(0.62, 0.4), NumberSequenceKeypoint.new(1, 1),
                }
            )
            local lineFrames = {}

            for i = 1, logoConfig.maxLines do
                local frame4 = Instance.new("Frame", screenGui)
                frame4.BackgroundColor3 = particleColors[1]
                frame4.BorderSizePixel = 0
                frame4.BackgroundTransparency = 1
                frame4.ZIndex = 19
                lineFrames[i] = frame4
            end

            local particles = {}

            local function resetParticle(particle)
                local edge = math.random(4)

                if edge == 1 then
                    particle.startX = math.random()
                    particle.startY = -0.02
                elseif edge == 2 then
                    particle.startX = 1.02
                    particle.startY = math.random()
                elseif edge == 3 then
                    particle.startX = math.random()
                    particle.startY = 1.02
                else
                    particle.startX = -0.02
                    particle.startY = math.random()
                end

                particle.targetX = 0.25 + math.random() * 0.5
                particle.targetY = 0.25 + math.random() * 0.5
                particle.curveAmp = (math.random() - 0.5) * 0.3
                particle.curvePhase = math.random() * math.pi
                particle.sizeBase = 10 + math.random() * 5
                local color = particleColors[math.random(#particleColors)]
                particle.f.BackgroundColor3 = color
                particle.glow.Color = color
                particle.dur = math.random() * 3 + 3.5
                particle.life = 0
                particle.rotDir = math.random() > 0.5 and 1 or -1
                particle.rotSpeed = math.random() * 60 + 30
                particle.px = 0
                particle.py = 0
                particle.velX = 0
                particle.velY = 0
                particle.bounceTimer = 0
            end

            for i = 1, 22 do
                local frame4 = Instance.new("Frame", screenGui)
                frame4.Size = UDim2.new(0, 14, 0, 14)
                frame4.AnchorPoint = Vector2.new(0.5, 0.5)
                frame4.BackgroundColor3 = particleColors[math.random(#particleColors)]
                frame4.BorderSizePixel = 0
                frame4.ZIndex = 20
                Instance.new("UICorner", frame4).CornerRadius = UDim.new(1, 0)
                local uiStroke = Instance.new("UIStroke", frame4)
                uiStroke.Thickness = 1
                uiStroke.Color = frame4.BackgroundColor3
                uiStroke.Transparency = 0.5
                particles[i] = {f = frame4, glow = uiStroke, life = math.random() * 5}
                resetParticle(particles[i])
            end

            local elapsed = 0
            local connection = nil

            connection = RunService.RenderStepped:Connect(
                function(deltaTime)
                    if not screenGui or not screenGui.Parent then
                        if connection then
                            connection:Disconnect()
                        end

                        return
                    end

                    elapsed += deltaTime
                    local absoluteSize = screenGui.AbsoluteSize
                    local screenW = math.max(absoluteSize.X, 1)
                    local screenH = math.max(absoluteSize.Y, 1)
                    local centerX = screenW * 0.5
                    local centerY = screenH * 0.5
                    local cycleT = elapsed % 4 / 4
                    local easeT = cycleT < 0.5 and 2 * cycleT * cycleT or 1 - math.pow(
                        -2 * cycleT + 2, 2
                    ) / 2
                    local rotation = math.floor(elapsed / 4) * 360 + easeT * 360 + math.sin(
                        elapsed * 3
                    ) * 10
                    local scaleX = 1 + 0.08 * math.sin(elapsed * 1.8)
                    local scaleY = 1 + 0.08 * math.cos(elapsed * 1.8)
                    local breathe = 1 + logoConfig.breatheAmp * math.sin(
                        elapsed * logoConfig.breatheFreq * 3.1415926535897931 * 2
                    )
                    logoFrame.Rotation = rotation
                    logoFrame.Size = UDim2.new(
                        0, logoConfig.logoSize * breathe * scaleX, 0,
                        logoConfig.logoSize * breathe * scaleY
                    )
                    logoFrame.Position = UDim2.new(
                        0.5, math.sin(elapsed * 0.7) * 6, 0.5, math.cos(elapsed * 1.1) * 6
                    )
                    local colorT = elapsed * 0.15
                    local colorCount = #ringColors
                    local colorIdx = math.floor(colorT) % colorCount + 1
                    local nextColorIdx = colorIdx % #ringColors + 1
                    local colorAlpha = colorT - math.floor(colorT)
                    local pulseColor = lerpColor(
                        ringColors[colorIdx], ringColors[nextColorIdx],
                        colorAlpha * colorAlpha * (3 - 2 * colorAlpha)
                    )
                    local pulseA = 0.5 + 0.5 * math.sin(elapsed * 0.6)

                    for i, particle in ipairs(rings) do
                        particle.frame.Rotation = elapsed * particle.rotSpeed * particle.rotDir
                        local pulseB = 1 + 0.06 * math.sin(
                            elapsed * (0.7 + i * 0.2) + particle.colorPhase
                        )
                        particle.frame.Size = UDim2.new(
                            0, particle.baseSize * pulseB, 0, particle.baseSize * pulseB
                        )
                        particle.currentRadius = particle.baseSize / 2 * pulseB
                        particle.stroke.Transparency = 0.35 + i * 0.1 + pulseA * 0.08
                        particle.stroke.Color = pulseColor
                        particle.glow.Color = pulseColor
                        particle.glow.Transparency = 0.75 + pulseA * 0.1
                    end

                    local pulseB = 0.5 + 0.5 * math.sin(
                        elapsed * logoConfig.pulseFreq * 3.1415926535897931 * 2
                    )
                    local pulseC = 0.5 + 0.5 * math.sin(
                        elapsed * logoConfig.pulseFreq * 3.1415926535897931 * 2 + 2.1991148575128552
                    )
                    gradFrame1.Size = UDim2.new(
                        1, 0, 0, logoConfig.gradHeight * (0.8 + pulseB * 0.4)
                    )
                    gradFrame2.Size = UDim2.new(
                        1, 0, 0, logoConfig.gradHeight * (0.6 + pulseC * 0.6)
                    )
                    gradFrame3.Size = UDim2.new(1, 0, 0, 100 + pulseB * 80)
                    uiGradient3.Offset = Vector2.new(math.sin(elapsed * 0.8) * 0.9, 0)
                    local currentRadius = rings[3].currentRadius

                    for _, particle in ipairs(particles) do
                        particle.life = particle.life + deltaTime

                        if particle.dur < particle.life then
                            resetParticle(particle)
                        end

                        local lineDistSq = particle.life / particle.dur
                        local px, py

                        if particle.bounceTimer > 0 then
                            particle.bounceTimer = particle.bounceTimer - deltaTime
                            particle.velX = particle.velX * 0.95
                            particle.velY = particle.velY * 0.95
                            px = particle.px + particle.velX * deltaTime
                            py = particle.py + particle.velY * deltaTime
                        else
                            local lineIdx = 1 - math.pow(1 - lineDistSq, 3)
                            local dx = particle.startX + (particle.targetX - particle.startX) * lineIdx
                            local dy = particle.startY + (particle.targetY - particle.startY) * lineIdx
                            local distSq = particle.targetX - particle.startX
                            local lineAlpha = particle.targetY - particle.startY
                            local dist = distSq * distSq + lineAlpha * lineAlpha

                            if dist > 0 then
                                local otherParticle = math.sqrt(dist)
                                local curveAmp = particle.curveAmp
                                local curveOffset = math.sin(
                                    lineDistSq * math.pi + particle.curvePhase
                                ) * curveAmp
                                dx += -lineAlpha / otherParticle * curveOffset
                                dy += distSq / otherParticle * curveOffset
                            end

                            px = dx * screenW
                            py = dy * screenH
                        end

                        local lineIdx = px - centerX
                        local dx = py - centerY
                        local dy = lineIdx * lineIdx + dx * dx

                        if dy < currentRadius * currentRadius and dy > 0.01 then
                            local otherParticle = math.sqrt(dy)
                            local distSq = lineIdx / otherParticle
                            local lineAlpha = dx / otherParticle
                            px = centerX + distSq * (currentRadius + 2)
                            py = centerY + lineAlpha * (currentRadius + 2)
                            local dist = (math.random() - 0.5) * 0.5
                            local dx2 = math.cos(dist)
                            local dy2 = math.sin(dist)
                            particle.velX = (distSq * dx2 - lineAlpha * dy2) * logoConfig.repelForce
                            particle.velY = (distSq * dy2 + lineAlpha * dx2) * logoConfig.repelForce
                            particle.bounceTimer = logoConfig.bounceCooldown
                        end

                        particle.px = px
                        particle.py = py
                        particle.f.Position = UDim2.new(
                            particle.px / screenW, 0, particle.py / screenH, 0
                        )
                        local otherParticle = math.sin(lineDistSq * 3.1415926535897931)
                        particle.f.BackgroundTransparency = 1 - otherParticle * 0.9
                        particle.glow.Transparency = 0.5 + (1 - otherParticle) * 0.4
                        particle.f.Size = UDim2.new(
                            0, particle.sizeBase * (1 - lineDistSq * 0.3), 0,
                            particle.sizeBase * (1 - lineDistSq * 0.3)
                        )
                        particle.f.Rotation = elapsed * particle.rotSpeed * particle.rotDir
                    end

                    local lineDistSq = logoConfig.lineDist * logoConfig.lineDist
                    local lineIdx = 1

                    for i = 1, #particles do
                        local particle = particles[i]
                        local otherParticle = math.sin(
                            particle.life / particle.dur * 3.1415926535897931
                        )

                        if otherParticle < 0.1 then
                            continue
                        else
                            for i2 = i + 1, #particles do
                                if not (logoConfig.maxLines < lineIdx) then
                                    local dx2 = particles[i2]
                                    local dy2 = math.sin(dx2.life / dx2.dur * 3.1415926535897931)

                                    if not (dy2 < 0.1) then
                                        local dx = dx2.px - particle.px
                                        local dy = dx2.py - particle.py
                                        local distSq = dx * dx + dy * dy

                                        if distSq < lineDistSq and distSq > 0 then
                                            local dist2 = math.sqrt(distSq)
                                            local lineFrame = lineFrames[lineIdx]
                                            lineIdx += 1
                                            local lineAlpha = 1 - dist2 / logoConfig.lineDist
                                            lineFrame.Size = UDim2.new(
                                                0, dist2, 0, logoConfig.lineThickness
                                            )
                                            lineFrame.Position = UDim2.new(
                                                0, (particle.px + dx2.px) / 2, 0,
                                                (particle.py + dx2.py) / 2
                                            )
                                            lineFrame.AnchorPoint = Vector2.new(0.5, 0.5)
                                            lineFrame.Rotation = math.deg(math.atan2(dy, dx))
                                            lineFrame.BackgroundTransparency = 1 - lineAlpha * 0.75 * math.min(
                                                otherParticle, dy2
                                            )
                                            lineFrame.BackgroundColor3 = pulseColor
                                        end
                                    end

                                    continue
                                end

                                break
                            end

                            if not (logoConfig.maxLines < lineIdx) then
                                continue
                            end
                        end

                        break
                    end

                    for i = lineIdx, #lineFrames do
                        lineFrames[i].BackgroundTransparency = 1
                        lineFrames[i].Size = UDim2.new(0, 0, 0, 0)
                    end
                end
            )

            local CACHE_FOLDER = "WraithBeta"

            isFunction = function(value)
                return type(value) == "function"
            end

            local function ensureFolder(arg)
                if isFunction(isfolder) then
                    local ok, result = pcall(isfolder, arg)
                    if ok and result then
                        return true
                    end
                end

                if isFunction(makefolder) then
                    if pcall(makefolder, arg) then
                        return true
                    end
                end

                return false
            end

            ensureFolder("WraithBeta")

            local function cachePath(arg)
                return CACHE_FOLDER .. "/" .. arg
            end

            local cachePaths = {
                cachePath("windui_cache.lua"), CACHE_FOLDER .. "/windui_cache.lua",
                "wraith_windui_cache.lua", "windui_cache.lua",
            }

            local windUIUrls = {
                "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
                "https://raw.githubusercontent.com/Footagesus/WindUI/main/main.lua",
                "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua",
                "https://cdn.jsdelivr.net/gh/Footagesus/WindUI@main/dist/main.lua",
                "https://cdn.jsdelivr.net/gh/Footagesus/WindUI@main/main.lua",
                "https://raw.githack.com/Footagesus/WindUI/main/dist/main.lua",
                "https://ghproxy.net/https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
                "https://mirror.ghproxy.com/https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
                "https://gh.llkk.cc/https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
                "https://hub.gitmirror.com/https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
            }

            local windUILib = nil
            local loadErrorMsg = nil
            loadSource = nil

            local function setLoaderStatus(arg)
                pcall(
                    function()
                        if not screenGui or not screenGui.Parent then
                            return
                        end
                        local wraithLoaderStatus = screenGui:FindFirstChild("WraithLoaderStatus")

                        if not wraithLoaderStatus then
                            wraithLoaderStatus = Instance.new("TextLabel")
                            wraithLoaderStatus.Name = "WraithLoaderStatus"
                            wraithLoaderStatus.AnchorPoint = Vector2.new(0.5, 0)
                            wraithLoaderStatus.Position = UDim2.new(
                                0.5, 0, 0.5, logoConfig.logoSize / 2 + 28
                            )
                            wraithLoaderStatus.Size = UDim2.fromOffset(700, 30)
                            wraithLoaderStatus.BackgroundTransparency = 1
                            wraithLoaderStatus.TextColor3 = Color3.fromRGB(235, 225, 255)
                            wraithLoaderStatus.TextTransparency = 0.04
                            wraithLoaderStatus.Font = Enum.Font.GothamMedium
                            wraithLoaderStatus.TextSize = 13
                            wraithLoaderStatus.Parent = screenGui
                        end

                        wraithLoaderStatus.Text = tostring(arg or "")
                    end
                )
            end

            local function isValidLuaSource(arg)
                return type(arg) == "string" and #arg > 500 and not arg:lower():find(
                    "<!doctype html", 1, true
                ) and not arg:lower():find("<html", 1, true)
            end

            local function tryCompileWindUI(source, sourceLabel)
                if not isValidLuaSource(source) then
                    loadErrorMsg = "Invalid/HTML response"
                    return false
                end
                local loadstring_ = getgenv and getgenv().loadstring or loadstring
                if type(loadstring_) ~= "function" then
                    loadErrorMsg = "loadstring is not supported"
                    return false
                end
                local chunk, compileErr = loadstring_(source)
                if type(chunk) ~= "function" then
                    loadErrorMsg = "Compile err: " .. tostring(compileErr)
                    return false
                end
                local ok, result = pcall(chunk)

                if ok and type(result) == "table" then
                    windUILib = result
                    loadSource = sourceLabel
                    setLoaderStatus("Loaded WindUI from " .. tostring(sourceLabel))
                    return true
                end

                local windUI = getgenv and getgenv().WindUI or _G.WindUI

                if type(windUI) == "table" then
                    windUILib = windUI
                    loadSource = sourceLabel
                    setLoaderStatus("Loaded WindUI from " .. tostring(sourceLabel))
                    return true
                end

                loadErrorMsg = tostring(result or compileErr or "unknown error")
                return false
            end

            local function readCacheFile(arg)
                if isFunction(isfile) then
                    local ok, result = pcall(isfile, arg)
                    if not ok or not result then
                        return nil
                    end
                end

                if isFunction(readfile) then
                    local ok, result = pcall(readfile, arg)
                    if ok and type(result) == "string" and #result > 0 then
                        return result
                    end
                end

                return nil
            end

            local function writeCacheFiles(arg)
                if not isValidLuaSource(arg) or not isFunction(writefile) then
                    return
                end
                ensureFolder("WraithBeta")

                for _, path in ipairs(cachePaths) do
                    pcall(writefile, path, arg)
                end
            end

            local function httpGet(arg)
                local ok, result = pcall(
                    function()
                        return game:HttpGet(arg, true)
                    end
                )

                if ok and type(result) == "string" and #result > 0 then
                    return result
                end
                local request_ = syn and syn.request or http_request or request or http and http.request

                if type(request_) == "function" then
                    local ok2, result2 = pcall(request_, {Url = arg, Method = "GET"})

                    if ok2 and result2 then
                        local body = result2.Body or result2.body
                        if type(body) == "string" and #body > 0 then
                            return body
                        end
                    end
                end

                loadErrorMsg = tostring(result)
                return nil
            end

            for _, path in ipairs(cachePaths) do
                setLoaderStatus("Checking cache: " .. path)
                local cached = readCacheFile(path)
                if cached and tryCompileWindUI(cached, "cache: " .. path) then
                    break
                end
            end

            local needDownload = not windUILib

            if needDownload then
                for i, downloadUrl in ipairs(windUIUrls) do
                    setLoaderStatus("Downloading WindUI (" .. i .. "/" .. #windUIUrls .. ")")
                    local body = httpGet(downloadUrl)

                    if body and tryCompileWindUI(body, downloadUrl) then
                        writeCacheFiles(body)
                        break
                    else
                        task.wait(0.05)
                    end
                end
            end

            if not windUILib then
