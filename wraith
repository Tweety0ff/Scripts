                part2.CanTouch = false
                part2.CanQuery = false
                part2.Transparency = 1
                part2.Size = arg.Size
                part2.CFrame = arg.CFrame
                part2.Parent = Workspace
                return part2
            end

            local function createProxy(arg)
                if pcldEntries[arg] then
                    return
                end
                local entry = getPartFrom(arg)
                if not entry then
                    return
                end
                local proxy = createPart(entry)
                local selectionBox = Instance.new("SelectionBox")
                selectionBox.Name = "WraithParticleBox"
                selectionBox.Adornee = proxy
                selectionBox.Color3 = color
                selectionBox.Transparency = transparency
