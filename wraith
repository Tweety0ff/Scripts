                    if not autoDockEnabled and isDocked then
                        isDocked = false
                        mainFrame.AnchorPoint = Vector2.new(0, 0)
                        fullView.Visible = true
                        dockedView.Visible = false

                        if unused then
                            unused:Cancel()
                        end

                        local config = {
                            Size = playerConfig.NormalSize,
                            BackgroundTransparency = playerConfig.BgTransparency
                        }
                        TweenService2:Create(
                            mainFrame,
                            TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                            config
                        ):Play()
                    end
                end,
            }
        )

        do
            local enabled5 = false
            local enabled6 = false
            local enabled7 = false
            local enabled8 = false
            local volume = 1.8

            local config = {
                Skeet = 83717596220569, Fatality = 115982072912004, Bell = 139452805868562,
                Click = 87437544236708, UwU = 124356179581089, Neverlose = 8679627751,
                Hitmarker = 4817809188,
            }

            local modeStr = "Skeet"
            local loadErrorMsg = "Fatality"
            local modeStr3 = "Hitmarker"
            local modeStr4 = "Skeet"

            local function formatTime()
                return config[modeStr4] or config.Skeet
            end

            local function undock(position3)
                local enabled9 = position3 ~= nil and position3 ~= Vector3.zero
                local part2 = nil
                local descName = SoundService

                if enabled9 then
                    part2 = Instance.new("Part")
                    part2.Name = "WraithCleanSoundEmitter"
                    part2.Anchored = true
                    part2.CanCollide = false
                    part2.Transparency = 1
                    part2.Size = Vector3.one
                    part2.Position = position3
                    part2.Parent = Workspace
                    descName = part2
                end

                local sound3 = Instance.new("Sound")
                sound3.Name = "WraithCleanBypassSound"
                sound3.SoundId = "rbxassetid://" .. formatTime()
                sound3.Volume = volume

                if enabled9 then
                    sound3.RollOffMaxDistance = 350
                end

                sound3.Parent = descName
                sound3:Play()

                task.spawn(
                    function()
                        sound3.Ended:Wait()

                        pcall(
                            function()
                                sound3:Destroy()
                            end
                        )

                        if part2 and part2.Parent then
                            pcall(
                                function()
                                    part2:Destroy()
                                end
                            )
                        end
                    end
                )
            end

            local function playTrack(arg)
                if not arg:IsA("Sound") then
                    return
                end

                if string.lower(arg.Name) == "ragdollhit" then
                    arg.Played:Connect(
                        function()
                            if not enabled5 then
                                return
                            end

                            pcall(
                                function()
                                    arg.Volume = 0
                                end
                            )

                            pcall(
                                function()
                                    arg:Stop()
                                end
                            )

                            local parent = arg.Parent
                            local isBasePart = parent and parent:IsA("BasePart")
                            local vector = Vector3.zero

                            if isBasePart then
                                vector = parent.Position
                            end

                            modeStr4 = modeStr
                            undock(vector)
                        end
                    )
                end
            end

            local function playIndex(arg)
                for _, descendant in ipairs(arg:GetDescendants()) do
                    if descendant:IsA("Sound") and string.lower(descendant.Name) == "ragdollhit" then
                        playTrack(descendant)
                    end
                end
            end

            pcall(
                function()
                    playIndex(Workspace)
                    playIndex(SoundService)
                end
            )

            Workspace.DescendantAdded:Connect(
                function(descendant)
                    if descendant:IsA("Sound") then
                        playTrack(descendant)
                    end

                    if enabled6 then
                        local descName = string.lower(descendant.Name)

                        if descName == "blackholekick" or descName == "blackholebuildup" or descName == "blackholekickeffect" or descName:find(
                            "blackholekick"
                        ) or descName:find("blackhole") then
                            task.wait(0.01)
                            local position3

                            if descendant:IsA("BasePart") then
                                position3 = descendant.Position
                            elseif descendant:IsA("Model") and descendant.PrimaryPart then
                                position3 = descendant.PrimaryPart.Position
                            else
                                position3 = nil

                                if descendant:IsA("Model") then
                                    local basePart = descendant:FindFirstChildWhichIsA(
                                        "BasePart", true
                                    )
                                    position3 = nil

                                    if basePart then
                                        position3 = basePart.Position
                                    end
                                end
                            end

                            if position3 then
                                undock(position3)

                                if enabled8 then
                                    local model = descendant:FindFirstAncestorOfClass("Model")

                                    wraithNotify(
                                        {
                                            Title = "Kick Detected",
                                            Description = (model and model.Name or "Player") .. " kick",
                                            Duration = 2.5,
                                        }
                                    )
                                end
                            end
                        end
                    end
                end
            )

            SoundService.DescendantAdded:Connect(
                function(descendant)
                    if descendant:IsA("Sound") then
                        playTrack(descendant)
                    end
                end
            )

            local progress = 0

            Workspace.DescendantAdded:Connect(
                function(descendant)
                    local descName = string.lower(descendant.Name)

                    if enabled7 and (descName == "grabparts" or descName == "grabpart" or descName:find(
                        "grabparts", 1, true
                    )) then
                        local position3

                        if descendant:IsA("BasePart") then
                            position3 = descendant.Position
                        else
                            position3 = nil

                            if descendant:IsA("Model") then
                                position3 = descendant.PrimaryPart or descendant:FindFirstChildWhichIsA(
                                    "BasePart", true
                                )
                                position3 = position3 and position3.Position
                            end
                        end

                        local humanoidRootPart = localPlayer.Character and localPlayer.Character:FindFirstChild(
                            "HumanoidRootPart"
                        )

                        if position3 and humanoidRootPart and (position3 - humanoidRootPart.Position).Magnitude <= 30 and tick(
                        ) - progress > 0.25 then
                            progress = tick()
                            modeStr4 = modeStr3
                            undock(nil)
                        end
                    end
                end
            )

            local soundsSection = tabAudio:Section({Title = "Sounds"})

            soundsSection:Toggle(
                {
                    Title = "Ragdoll Sound (Override RagdollHit)", Value = false,
                    Callback = function(arg)
                        ragdollOverride = arg
                    end,
                }
            )

            soundsSection:Toggle(
                {
                    Title = "Kick Sound (3D BlackHoleKick)", Value = false,
                    Callback = function(arg)
                        kickSound = arg
                    end,
                }
            )

            soundsSection:Toggle(
                {
                    Title = "Grab Sound (30 studs)", Value = false,
                    Callback = function(arg)
                        grabSound = arg
                    end,
                }
            )

            soundsSection:Dropdown(
                {
                    Title = "Ragdoll Sound",
                    Values = {"Skeet", "Fatality", "Bell", "Click", "UwU", "Neverlose", "Hitmarker"},
                    Value = "Skeet",
                    Callback = function(arg)
                        ragdollSound = arg
                    end,
                }
            )

            soundsSection:Dropdown(
                {
                    Title = "Kick Sound",
                    Values = {"Skeet", "Fatality", "Bell", "Click", "UwU", "Neverlose", "Hitmarker"},
                    Value = "Fatality",
                    Callback = function(arg)
                        loadErrorMsg = arg
                    end,
                }
            )

            soundsSection:Dropdown(
                {
                    Title = "Grab Sound",
                    Values = {"Skeet", "Fatality", "Bell", "Click", "UwU", "Neverlose", "Hitmarker"},
                    Value = "Hitmarker",
                    Callback = function(arg)
                        grabSoundName = arg
                    end,
                }
            )

            soundsSection:Slider(
                {
                    Title = "Volume", Value = {Min = 1, Max = 50, Default = 18},
                    Callback = function(arg)
                        soundVolume = arg / 10
                    end,
                }
            )

            soundsSection:Toggle(
                {
                    Title = "Notify on Kick", Value = false,
                    Callback = function(arg)
                        notifyOnKick = arg
                    end,
                }
            )
        end

