                                        local y = onScreen.Y
                                        local y2 = screenA.Y
                                        local vector2 = Vector2.new(lineIndex - boxHeight / 2, y)
                                        local vector22 = Vector2.new(lineIndex + boxHeight / 2, y)
                                        local vector23 = Vector2.new(lineIndex + boxHeight / 2, y2)
                                        local vector24 = Vector2.new(lineIndex - boxHeight / 2, y2)
