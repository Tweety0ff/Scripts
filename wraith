                        Size = playerConfig.NormalSize,
                        BackgroundTransparency = playerConfig.BgTransparency
                    }
                    local tween = TweenService2:Create(
                        mainFrame,
                        TweenInfo.new(0.4, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), config
                    )
                    unused = tween
                    tween:Play()
                end
            end

            local function playTrack(arg)
                local match = tostring(arg):match("%d+")
                if not match then
                    songTitle.Text = "Ошибка ID"
                    return
                end
                audio.SoundId = "rbxassetid://" .. match
                musicIdLabel.Text = "ID: " .. match
                songTitle.Text = "Загрузка..."

                task.spawn(
                    function()
                        local productInfo = nil

                        if pcall(
                            function()
                                local asset = Enum.InfoType.Asset
                                productInfo = MarketplaceService:GetProductInfo(
                                    tonumber(match), asset
                                )
                            end
                        ) and productInfo and productInfo.Name then
                            songTitle.Text = productInfo.Name
                        else
                            songTitle.Text = "Track #" .. match
                        end
                    end
                )

                audio:Play()
                isPlaying = true
                playBtn.Text = playerConfig.IconPause
            end

            local function playIndex(arg)
                if #playlist == 0 then
                    return
                end

                if arg < 1 then
                    arg = #playlist
                end

                if #playlist < arg then
                    arg = 1
                end

                currentIndex = arg
                playTrack(playlist[currentIndex])
            end

            local function addToPlaylist(arg)
                if not arg or arg == "" then
                    return
                end
                table.insert(playlist, arg)

                if #playlist == 1 or not isPlaying then
                    playIndex(#playlist)
                end
            end

            local function toggleInputDrawer(arg)
                inputOpen = arg
                undock()

                if inputOpen then
                    canvasGroup.Visible = true
                    TweenService2:Create(
                        canvasGroup,
                        TweenInfo.new(0.35, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out),
                        {Position = UDim2.new(0, 12, 0, -42), GroupTransparency = 0}
                    ):Play()

                    task.delay(
                        0.1,
                        function()
                            if inputOpen then
                                idInput:CaptureFocus()
                            end
                        end
                    )
                else
                    idInput:ReleaseFocus()
                    local tween = TweenService2:Create(
                        canvasGroup,
                        TweenInfo.new(0.25, Enum.EasingStyle.Cubic, Enum.EasingDirection.In),
                        {Position = UDim2.new(0, 12, 0, -10), GroupTransparency = 1}
                    )
                    tween:Play()

                    tween.Completed:Connect(
                        function()
                            if not inputOpen then
                                canvasGroup.Visible = false
                            end
                        end
                    )
                end
            end

            dotsBtn.MouseButton1Click:Connect(
                function()
                    toggleInputDrawer(not inputOpen)
                end
            )

            idInput.FocusLost:Connect(
                function(enterPressed)
                    if enterPressed then
                        if idInput.Text ~= "" then
                            addToPlaylist(idInput.Text)
                            idInput.Text = ""
                        end

                        toggleInputDrawer(false)
                    end
                end
            )

            mainFrame.InputBegan:Connect(
                function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        undock()
                        isDragging = true

                        if isDocked then
                            isDocked = false
                            mainFrame.AnchorPoint = Vector2.new(0, 0)
                            fullView.Visible = true
                            dockedView.Visible = false

                            if unused then
                                unused:Cancel()
                            end

                            local config = {
                                Size = playerConfig.NormalSize,
                                BackgroundTransparency = playerConfig.BgTransparency
                            }
                            TweenService2:Create(
                                mainFrame,
                                TweenInfo.new(
                                    0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out
                                ), config
                            ):Play()
                        end

                        dragStart = input.Position
                        frameStartPos = mainFrame.Position
                        TweenService2:Create(
                            uiScale,
                            TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                            {Scale = 1.035}
                        ):Play()
                    end
                end
            )

            UserInputService2.InputChanged:Connect(
                function(input)
                    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        local delta = input.Position - dragStart
                        local viewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(
                            1920, 1080
                        )
                        local absoluteSize = mainFrame.AbsoluteSize
                        local clampedX = math.clamp(
                            frameStartPos.X.Offset + delta.X, 0,
                            math.max(0, viewportSize.X - absoluteSize.X)
                        )
                        local clampedY = math.clamp(
                            frameStartPos.Y.Offset + delta.Y, 0,
                            math.max(0, viewportSize.Y - absoluteSize.Y)
                        )
                        mainFrame.Position = UDim2.fromOffset(clampedX, clampedY)
                        undock()
                    end
                end
            )

            UserInputService2.InputEnded:Connect(
                function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = false
                        TweenService2:Create(
                            uiScale,
                            TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                            {Scale = 1}
                        ):Play()
                    end
                end
            )

            playBtn.MouseButton1Click:Connect(
                function()
                    undock()

                    if isPlaying then
                        audio:Pause()
                        isPlaying = false
                        playBtn.Text = playerConfig.IconPlay
                    elseif audio.SoundId ~= "" then
                        audio:Resume()
                        isPlaying = true
                        playBtn.Text = playerConfig.IconPause
                    elseif #playlist > 0 then
                        playIndex(currentIndex)
                    end
                end
            )

            prevBtn.MouseButton1Click:Connect(
                function()
                    undock()
                    playIndex(currentIndex - 1)
                end
            )

            nextBtn.MouseButton1Click:Connect(
                function()
                    undock()
                    playIndex(currentIndex + 1)
                end
            )

            RunService2.RenderStepped:Connect(
                function()
                    if playerGui.Enabled then
                        local viewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize

                        if viewportSize and mainFrame.AnchorPoint == Vector2.new(0, 0) then
                            local absolutePosition = mainFrame.AbsolutePosition
                            local absoluteSize = mainFrame.AbsoluteSize
                            local clampedX = math.clamp(
                                absolutePosition.X, 0, math.max(0, viewportSize.X - absoluteSize.X)
                            )
                            local clampedY = math.clamp(
                                absolutePosition.Y, 0, math.max(0, viewportSize.Y - absoluteSize.Y)
                            )

                            if clampedX ~= absolutePosition.X or clampedY ~= absolutePosition.Y then
                                mainFrame.Position = UDim2.fromOffset(clampedX, clampedY)
                            end
                        end
                    end

                    local timePosition = audio.TimePosition
                    local timeLength = audio.TimeLength

                    if timeLength > 0 then
                        local progress = math.clamp(timePosition / timeLength, 0, 1)
                        barFill.Size = UDim2.new(progress, 0, 1, 0)
                        dockedBarFill.Size = UDim2.new(progress, 0, 1, 0)
                        timeCurrent.Text = formatTime(timePosition)
                        timeTotal.Text = formatTime(timeLength)
                        dockedTime.Text = formatTime(timeLength)
                    else
                        barFill.Size = UDim2.new(0, 0, 1, 0)
                        dockedBarFill.Size = UDim2.new(0, 0, 1, 0)
                        timeCurrent.Text = "0:00"
                        timeTotal.Text = "0:00"
                        dockedTime.Text = "0:00"
                    end

                    if playerConfig.AutoDockEnabled and not isDocked and not isDragging and not inputOpen then
                        if playerConfig.AutoDockTime < tick() - lastInteract then
                            local absolutePosition = mainFrame.AbsolutePosition
                            local enabled5 = absolutePosition.Y < playerConfig.EdgeDistance

                            if enabled5 or workspace.CurrentCamera.ViewportSize.Y - absolutePosition.Y + mainFrame.AbsoluteSize.Y < playerConfig.EdgeDistance then
                                if unused then
                                    unused:Cancel()
                                end

                                isDocked = true
                                fullView.Visible = false
                                dockedView.Visible = true
                                local absolutePosition2 = mainFrame.AbsolutePosition
                                local absoluteSize = mainFrame.AbsoluteSize
                                mainFrame.AnchorPoint = Vector2.new(0, 0)
                                mainFrame.Position = UDim2.fromOffset(
                                    absolutePosition2.X,
                                    enabled5 and absolutePosition2.Y or absolutePosition2.Y + absoluteSize.Y - playerConfig.DockedSize.Y.Offset
                                )
                                local config = {
                                    Size = playerConfig.DockedSize, BackgroundTransparency = 0.5
                                }
                                local tween = TweenService2:Create(
                                    mainFrame,
                                    TweenInfo.new(
                                        0.45, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out
                                    ), config
                                )
                                unused = tween
                                tween:Play()
                            end
                        end
                    end
                end
            )

            audio.Ended:Connect(
                function()
                    if #playlist > 0 then
                        playIndex(currentIndex + 1)
                    else
                        isPlaying = false
                        playBtn.Text = playerConfig.IconPlay
                    end
                end
            )
        end

        local soundPlayerSection = tabAudio:Section({Title = "Sound Player"})
        playerGui.Enabled = false

        soundPlayerSection:Toggle(
            {
