					if #history == 1 then
						return history[1].cf
					end

					if cfEW <= history[1].time then
						return history[1].cf
					end

					if history[#history].time <= cfEW then
						return history[#history].cf
					end

					for i = #history, 2, -1 do
						if history[i - 1].time <= cfEW and history[i].time >= cfEW then
							local entityC = history[i - 1]
							local entityB = history[i]
							local idxA = entityB.time - targetVV.time
							if idxA <= 0 then
