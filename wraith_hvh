function NeverLose:KeyCodeToStr(K)
	if not K then 
		return "None" 
	end;
	if typeof(K) == 'string' then
		if NeverLose.KeyEnum[K] then
			return NeverLose.KeyEnum[K];
		end;
		return K;
	end;
	local name = pcall(function() return K.Name end) and K.Name or "None"
	return (NeverLose.KeyEnum[name] or name);
end;

