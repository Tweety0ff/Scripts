				local function KickTargetPlayer(targetHX)
					pcall(function()
						local primaryPart = targetHX.PrimaryPart or targetHX:FindFirstChildWhichIsA("BasePart")
						local CombatItemsEspSection, targetIA, targetHY = GetCharacter()
						if not (primaryPart and targetHY) then
							return
						end
						local radiusR = primaryPart.Position - targetHY.Position
						local magnitude = radiusR.Magnitude
						if magnitude > 120 then
							return
						end
						local assemblyLinearVelocity = primaryPart.AssemblyLinearVelocity
						local dir = radiusR.Magnitude > 0.01 and radiusR.Unit or Vector3.new(0, 1, 0)
						local isMovingFast = assemblyLinearVelocity.Magnitude > 5 and assemblyLinearVelocity.Unit:Dot(-dir) > 0.4
						if magnitude > 25 and not isMovingFast then
							return
						end

						for _, descendant in pairs(targetHX:GetDescendants()) do
							if descendant:IsA("BasePart") then
								descendant.CanTouch = false
								descendant.CanCollide = false
								descendant.CanQuery = false
							end
						end

						local childKB = tick()

						while true do
							pcall(function()
								setNetworkOwner:FireServer(primaryPart, primaryPart.CFrame)
							end)

							if wraithPartOwned(primaryPart) then
								break
							else
								RunService.Heartbeat:Wait()
								if not (tick() - childKB > 0.25) then
									continue
								end
								break
							end
						end

						pcall(function()
							primaryPart.AssemblyLinearVelocity = Vector3.zero
							primaryPart.AssemblyAngularVelocity = Vector3.zero
							primaryPart.CFrame = CFrame.new(targetIC.Position + Vector3.new(0, -3000, 0))
							setNetworkOwner:FireServer(primaryPart, primaryPart.CFrame)
						end)

						pcall(function()
							destroyToy:FireServer(targetIB)
						end)

						pcall(function()
							targetIB:Destroy()
						end)
					end)
