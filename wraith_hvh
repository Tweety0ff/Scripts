					if descendant.Name == "BallSnowball" then
						local CombatItemsEspSection = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")

						if not (CombatItemsEspSection and descendant:IsDescendantOf(CombatItemsEspSection)) then
							KickTargetPlayer(descendant)
